{
  "name": "@notification-platform/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:cov": "jest --config jest.config.cjs --coverage --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "joi": "^18.3.2",
    "nestjs-pino": "^5.3.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
